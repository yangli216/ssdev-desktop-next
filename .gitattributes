# Detached signatures cover exact document bytes. Keep JSON checkout content
# stable across Windows, macOS, and Linux so signatures remain reproducible.
*.json text eol=lf

# Tauri rewrites generated command permissions with LF during every build.
# Force the checkout to the same representation so Windows builds do not make
# an otherwise clean source revision appear dirty before evidence generation.
apps/desktop/src-tauri/permissions/autogenerated/*.toml text eol=lf
