{
  "schemaVersion": 7,
  "protocolVersion": 1,
  "methods": [
    "invokePlugin",
    "getSystemInfo",
    "captureWindow",
    "openExternal",
    "openWindow",
    "showFloating",
    "closeFloating"
  ],
  "optionalMethods": [
    "invokePluginTracked",
    "getPluginInvocation"
  ],
  "capabilities": {
    "schemaVersion": 1,
    "trackedInvocations": [
      "supported",
      "available",
      "accepting",
      "errorCode",
      "limits"
    ],
    "trackedInvocationLimits": [
      "maxRuntimeOperations",
      "maxRetainedResponseBytes",
      "runtimeResultRetentionSeconds",
      "maxDurableOperations",
      "maxDurableOperationsPerScope",
      "completedRetentionSeconds",
      "indeterminateRetentionSeconds"
    ]
  },
  "pluginInvocationControlCodes": {
    "capacityBusy": -32001,
    "controllerStopping": -32002,
    "executionLaneTimeout": -32003,
    "trackedInvocationRequired": -32004,
    "pluginReloading": -32010
  },
  "trackedInvocationError": {
    "schemaVersion": 1,
    "kind": "trackedInvocationError",
    "fields": [
      "schemaVersion",
      "kind",
      "phase",
      "code"
    ],
    "phases": [
      "authorization",
      "runtime",
      "availability",
      "invoke",
      "status"
    ]
  },
  "trackedInvocationStatus": {
    "states": [
      "unknown",
      "pending",
      "completed",
      "indeterminate",
      "completedWithoutResult"
    ],
    "stateFields": {
      "unknown": [
        "state"
      ],
      "pending": [
        "state"
      ],
      "completed": [
        "state",
        "response",
        "durable"
      ],
      "indeterminate": [
        "state"
      ],
      "completedWithoutResult": [
        "state"
      ]
    },
    "responseFields": [
      "ResCode",
      "ResData"
    ]
  },
  "events": [
    "ssdev-capture",
    "ssdev-floating-action"
  ]
}
